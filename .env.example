# Lokal ishga tushirishda bo'sh qoldiring — SQLite ishlatiladi.
# Render, Railway, Neon yoki Supabase bergan manzilni shu yerga qo'ying.
# postgres:// ni o'zgartirish shart emas, ilova o'zi postgresql+psycopg qiladi.
DATABASE_URL=

# Rasmlar uchun Cloudinary. Bo'sh bo'lsa rasmlar server diskida qoladi.
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

GARDEBOB_CITY=Toshkent

# Ixtiyoriy: javoblarni tabiiyroq qilish. Bo'sh qolsa o'rnatilgan stilist ishlaydi.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
